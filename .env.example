# Copy this file to ".env" in the project root and fill in your own values.
# Never commit the real .env file (it is in .gitignore).

# --- Server ---
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string

# --- Database (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# --- URLs (used for password-reset links and Google/GitHub sign-in) ---
# Where the React app runs, and where this backend runs.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# --- Forgot password: email sending (SMTP) ---
# Optional while developing: if SMTP_HOST is empty, the reset link is printed
# in the backend terminal instead of being emailed.
# Gmail example: create an "App password" at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ShowCase Gallery <your-address@gmail.com>"

# --- Log in with Google ---
# https://console.cloud.google.com/apis/credentials -> Create OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Log in with GitHub ---
# https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
